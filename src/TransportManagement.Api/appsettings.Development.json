{
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:8080"]
  },
  "DevelopmentSeed": {
    "Enabled": false,
    "OwnerEmail": "owner@demo.local",
    "CompanyName": "Demo Transport",
    "CompanySlug": "demo-transport"
  },
  "Tracking": {
    "Provider": "Simulator",
    "SimulatorEnabled": true,
    "PollingIntervalSeconds": 5,
    "OfflineThresholdSeconds": 30,
    "HistoryHeartbeatSeconds": 300,
    "SimulatorHeartbeatSeconds": 60,
    "SimulatorSpeedKilometersPerHour": 65,
    "SimulatorStepDistanceMeters": 1000
  },
  "Routing": {
    "Provider": "Osrm",
    "BaseUrl": "https://router.project-osrm.org",
    "UserAgent": "TransportManagementDevelopment/0.1 (+https://github.com/ahmadqwcv5-droid/transport-management-system)",
    "TimeoutSeconds": 20,
    "OffRouteThresholdMeters": 150,
    "ArrivalThresholdMeters": 30
  },
  "Geocoding": {
    "Provider": "",
    "BaseUrl": "",
    "TimeoutSeconds": 8,
    "UserAgent": "TransportManagement-Development"
  }
}
