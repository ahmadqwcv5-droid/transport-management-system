# PostgreSQL / Docker Compose
POSTGRES_DB=transport_management
POSTGRES_USER=transport_app
POSTGRES_PASSWORD=replace-with-a-local-password

# Backend secrets and development seed (never commit real values)
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
DEMO_OWNER_PASSWORD=replace-with-a-development-password

# Flutter compile-time configuration
API_BASE_URL=http://localhost:5080
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Development-only tracking simulator
TRACKING_PROVIDER=Simulator
TRACKING_SIMULATOR_ENABLED=true
TRACKING_POLLING_INTERVAL_SECONDS=5
TRACKING_OFFLINE_THRESHOLD_SECONDS=30
