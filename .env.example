# PostgreSQL / Docker Compose
# Legacy and current Compose both honor this stable project identity. Passing
# `-p` explicitly still overrides it.
COMPOSE_PROJECT_NAME=tms-smoke
POSTGRES_DB=transport_management
POSTGRES_USER=transport_app
POSTGRES_PASSWORD=replace-with-a-local-password

# Backend secrets and development seed (never commit real values)
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
DEMO_OWNER_PASSWORD=replace-with-a-development-password

# Flutter compile-time configuration
API_BASE_URL=http://localhost:5080
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_LOADING_TIMEOUT_SECONDS=12
ENABLE_SIMULATOR_CONTROLS=true

# Development-only tracking simulator
TRACKING_PROVIDER=Simulator
TRACKING_SIMULATOR_HEARTBEAT_SECONDS=60
TRACKING_SIMULATOR_ENABLED=true
TRACKING_POLLING_INTERVAL_SECONDS=5
TRACKING_OFFLINE_THRESHOLD_SECONDS=30
TRACKING_HISTORY_HEARTBEAT_SECONDS=300
TRACKING_TRAIL_GAP_THRESHOLD_SECONDS=300
TRACKING_TRAIL_JUMP_THRESHOLD_METERS=5000
TRACKING_MAX_TRIP_HISTORY_POINTS=500
TRACKING_SIMULATOR_SPEED_KMH=65
TRACKING_SIMULATOR_STEP_DISTANCE_METERS=1000

# Dispatch freshness remains enforced; lower only for an isolated smoke test.
DISPATCH_MAXIMUM_POSITION_AGE_SECONDS=300

# Development routing (public OSRM demo: general driving, no SLA/HGV support)
ROUTING_PROVIDER=Osrm
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_USER_AGENT=TransportManagementDevelopment/0.1
ROUTING_TIMEOUT_SECONDS=20
ROUTING_OFF_ROUTE_THRESHOLD_METERS=150
ROUTING_ARRIVAL_THRESHOLD_METERS=30

# Leave geocoding disabled for manual map selection. Configure a policy-compliant
# managed Nominatim endpoint explicitly; do not use the public service for autocomplete.
GEOCODING_PROVIDER=
GEOCODING_BASE_URL=
GEOCODING_USER_AGENT=TransportManagement-Development
